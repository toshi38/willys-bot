#!/usr/bin/env bash
# Keeps secrets out of commits. Turned on by `npm install` / `npm ci`
# (the prepare script sets core.hooksPath to .githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# The recipe site's data is published as is: check it like the build does.
node --no-warnings=ExperimentalWarning src/recipes/check-staged.ts

# gitleaks, where it is installed, on everything staged.
if command -v gitleaks >/dev/null; then
  gitleaks git --pre-commit --staged --no-banner --redact
fi
