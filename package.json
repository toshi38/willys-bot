{
  "name": "willys-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:site": "node --no-warnings=ExperimentalWarning --test \"src/recipes/*.test.ts\"",
    "typecheck": "tsc",
    "wb": "node --no-warnings=ExperimentalWarning src/cli.ts",
    "mcp": "node --no-warnings=ExperimentalWarning src/mcp/server.ts",
    "web": "node --no-warnings=ExperimentalWarning src/web/server.ts",
    "eval": "node --no-warnings=ExperimentalWarning eval/run.ts",
    "site": "node --no-warnings=ExperimentalWarning src/recipes/build.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "marked": "^18.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
