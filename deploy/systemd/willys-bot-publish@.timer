# Every five minutes: an ordered week's recipes go on the recipe site a few
# minutes after the week is approved, and again after it changes. A run
# only reads the database unless a week has something new to push.
[Unit]
Description=food-bot: publish ordered weeks' recipes every five minutes (%i)

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
